/models/*.glb
  Content-Type: model/gltf-binary
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/audio/*.mp3
  Content-Type: audio/mpeg
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/_next/static/media/*.woff2
  Content-Type: font/woff2
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
